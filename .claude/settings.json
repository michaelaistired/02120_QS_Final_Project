{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/save_journal.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/save_journal.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/save_journal.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/save_journal.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/save_journal.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/save_journal.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_prompts.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_prompts.py\""
          }
        ]
      }
    ]
  }
}
